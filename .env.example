# Database
DB_NAME=codecoroner
DB_USER=codecoroner
DB_PASSWORD=dev_password_change_me
DB_HOST=postgres
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Django
DJANGO_SECRET_KEY=dev-secret-key-change-in-production
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Ollama
OLLAMA_BASE_URL=http://ollama:11434

# MinIO
MINIO_USER=codecoroner
MINIO_PASSWORD=minio_dev_password

# Logging
LOG_LEVEL=INFO

# Bind address for internal service ports (postgres, redis, minio, ollama,
# django, daphne, ai-engine, frontend). Only nginx stays public.
# Set to 0.0.0.0 only behind a trusted firewall.
BIND_ADDR=127.0.0.1

# Public ports and TLS mode (see README "TLS scenarios").
# CERT_MODE: selfsigned (dev/test) | byo (mount server.crt/key into nginx_certs)
#            | behind-proxy (plain HTTP, TLS on the customer's own proxy)
HTTP_PORT=8080
HTTPS_PORT=8443
CERT_MODE=selfsigned

# Memory limits (conservative defaults for a ~16 GB host).
# Raise OLLAMA_MEM_LIMIT for bigger tiers (7b needs ~8 GB, 14b more).
OLLAMA_MEM_LIMIT=8g
CELERY_MEM_LIMIT=4g

# Backups: local dir + retention for scripts/backup.sh.
# BACKUP_RSYNC_TARGET (optional): off-host copy target, e.g. user@nas:/backups/codecoroner/.
# Empty = local backups only.
# BACKUP_DIR=./backups
# RETENTION_DAYS=7
# BACKUP_RSYNC_TARGET=

# Watchdog (scripts/healthcheck.sh): alarm when DLQ exceeds this.
# DLQ_ALERT_THRESHOLD=5
