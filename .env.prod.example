# Production environment — copy to .env.prod and fill in REAL values.
# NEVER commit .env.prod. Generate secrets with: openssl rand -hex 32
# Used with: podman-compose -f podman-compose.yml -f podman-compose.prod.yml up -d --build

# --- Database (fail-fast in prod: defaults are rejected) ---
DB_NAME=codecoroner
DB_USER=codecoroner
DB_PASSWORD=CHANGE_ME_64_hex_chars

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Django (fail-fast in prod: defaults are rejected) ---
DJANGO_SECRET_KEY=CHANGE_ME_64_hex_chars
DJANGO_DEBUG=False
ALLOWED_HOSTS=your-host.example.com
CORS_ALLOWED_ORIGINS=https://your-host.example.com:8443
CSRF_TRUSTED_ORIGINS=https://your-host.example.com:8443

# --- Rate limiting (requests per hour) ---
RATE_LIMIT_USER=100/hour
RATE_LIMIT_ANON=10/hour

# --- Network ---
# Only nginx stays public; internal ports bind here.
BIND_ADDR=127.0.0.1

# --- TLS (see infra/nginx + README "TLS scenarios") ---
HTTPS_PORT=8443
HTTP_PORT=8080
# byo = mount your server.crt/server.key into the nginx_certs volume
# selfsigned = auto-generate (dev/test only) | behind-proxy = TLS off, proxy upstream
CERT_MODE=byo
ENABLE_HSTS=true

# --- Ollama ---
OLLAMA_BASE_URL=http://ollama:11434
# Raise for bigger tiers (7b needs ~8 GB, 14b more).
OLLAMA_MEM_LIMIT=8g
CELERY_MEM_LIMIT=4g

# --- MinIO ---
MINIO_USER=codecoroner
MINIO_PASSWORD=CHANGE_ME_32_hex_chars

# --- Logging ---
LOG_LEVEL=WARNING

# --- Backups (scripts/backup.sh) ---
# BACKUP_DIR=./backups
# RETENTION_DAYS=7
# BACKUP_RSYNC_TARGET=user@backup-host:/backups/codecoroner/

# --- Watchdog (scripts/healthcheck.sh) ---
# DLQ_ALERT_THRESHOLD=5
